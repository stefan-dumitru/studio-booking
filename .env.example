# Copy this file to .env and fill in the values. .env is gitignored and must
# never be committed (CLAUDE.md > Security Baseline).
#
# Keys are grouped by the build phase that first needs them. A key marked
# "Phase N" may be left blank until then -- config.ts only requires the ones
# the current code actually uses.

# --- Phase 0: skeleton and schema ---------------------------------------
# Postgres connection string for the application database.
# Local Postgres 18 example:
#   postgres://postgres:YOUR_PASSWORD@localhost:5432/studio_booking
DATABASE_URL=

# Same server, separate database, used only by the test suite. It is dropped
# and rebuilt by the tests, so never point this at anything you care about.
TEST_DATABASE_URL=

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# IANA zone for the studio's wall clock. Timestamps are stored in UTC and
# converted to this zone for display (specifications/ui-guidelines.md).
STUDIO_TIME_ZONE=Europe/Bucharest

# bcrypt work factor. Higher is slower and safer; 12 is a reasonable default.
BCRYPT_COST=12

# Used once by `npm run seed:admin` to create the first admin account, since
# there is no admin to create it through the UI.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# --- Phase 1: accounts --------------------------------------------------
# Secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public base URL, used to build verification and password-reset links. Never
# derived from the Host header, which is attacker-controlled.
APP_BASE_URL=http://localhost:5173

# SMTP connection string. Leave blank in development to log mail to the console.
SMTP_URL=
MAIL_FROM=

# How long a login session lasts without activity, and how long an emailed
# link stays valid. All three have sane defaults below; only set them if you
# want something other than that default.
SESSION_TTL_DAYS=7
VERIFY_TOKEN_TTL_HOURS=24
RESET_TOKEN_TTL_HOURS=1

# --- Phase 6: production readiness --------------------------------------
SENTRY_DSN=
